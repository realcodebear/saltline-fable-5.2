[Unit]
Description=提示词市集 API (market-api)
Documentation=https://github.com/your-org/saltline-fable-5.2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=market
Group=market
# 仓库根目录：静态文件（index.html、market/）与 server/ 都在这
WorkingDirectory=/srv/saltline-fable-5.2
EnvironmentFile=/srv/saltline-fable-5.2/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/saltline-fable-5.2/server/server.mjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# 日志走 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=market-api

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/saltline-fable-5.2/server/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
