# 服务端口（默认 8790）
PORT=8790
# 监听地址，反代场景建议 127.0.0.1
HOST=127.0.0.1

# 初始管理员（库中还没有 admin 时自动创建）
ADMIN_USER=admin
ADMIN_PASSWORD=请改成至少8位的高强度密码

# token 签名密钥（留空则自动生成到 data/secret.key）
SECRET=

# 审核事件 webhook（企业微信 / 钉钉 / Server酱 均可，留空关闭）
WEBHOOK_URL=

# 可选：站点名、静态根、数据目录、CORS 白名单、上传上限（MB）
# SITE_NAME=提示词市集
# STATIC_ROOT=F:\MyApp\eternal\saltline-fable-5.2
# DATA_DIR=F:\MyApp\eternal\saltline-fable-5.2\server\data
# ALLOW_ORIGIN=*
# UPLOAD_MAX_MB=3
